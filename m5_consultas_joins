USE Ventas_Tech_DB
;


--CONSULTA 1 

SELECT v.fecha_venta, v.id_cliente, c.nombre AS nombre_cliente, c.ciudad,
       p.nombre_producto, cat.nombre_categoria AS categoria,
       v.cantidad, v.precio_unitario,
       v.cantidad * v.precio_unitario AS total_venta
FROM ventas AS v
INNER JOIN clientes   AS c   ON v.id_cliente   = c.id_cliente
INNER JOIN productos  AS p   ON v.id_producto  = p.id_producto
INNER JOIN categorias AS cat ON p.id_categoria = cat.id_categoria
ORDER BY v.fecha_venta;


-- CONSULTA 2
SELECT c.nombre, c.email, c.fecha_registro
FROM clientes as c 
LEFT JOIN ventas AS v   ON c.id_cliente = v.id_cliente
WHERE v.id_venta IS NULL
-- Hallazgo: Ninguno de los 5 clientes quedaron sin comprar.


