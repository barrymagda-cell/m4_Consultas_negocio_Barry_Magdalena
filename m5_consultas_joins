--CONSULTA 4 
-- Proposito: comparar cuanto se facturo en cada periodo de marzo 2024.
-- La columna canal no existe en las tablas: la creo yo como texto fijo en cada SELECT.
SELECT
    canal,
    SUM(total)                              AS total_canal
FROM (
    SELECT fecha_venta, cantidad * precio_unitario AS total, 'Del 1 al 10 de marzo' AS canal
    FROM ventas
    WHERE fecha_venta <= '2024-03-10'

    UNION ALL

    SELECT fecha_venta, cantidad * precio_unitario AS total, 'Del 11 al 31 de marzo' AS canal
    FROM ventas
    WHERE fecha_venta > '2024-03-10'
) AS consolidado
GROUP BY canal;
-- Hallazgo: la primera etapa del mes facturo mas ($3620, el 56%) que la segunda ($2824, el 44%),
-- con la misma cantidad de ventas (5 y 5), asi que cayo el valor de cada venta.

